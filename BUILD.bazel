load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# Releases (binaries and debian packages) are built with goreleaser, see .goreleaser.yaml.
# The bazel build is only kept as reference, it builds and tests an unversioned binary.

# gazelle:prefix github.com/mgit-at/cert-viewer
gazelle(name = "gazelle")

go_library(
    name = "go_default_library",
    srcs = ["main.go"],
    importpath = "github.com/mgit-at/cert-viewer",
    visibility = ["//visibility:private"],
    deps = ["@com_github_spf13_pflag//:go_default_library"],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "integration_test.go",
        "main_test.go",
    ],
    embed = [":go_default_library"],
)

go_binary(
    name = "cert-viewer",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)
